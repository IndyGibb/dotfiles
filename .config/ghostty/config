# Font
font-family = DepartureMono Nerd Font
font-family = Ark Pixel 12px Mono ja
font-family = Noto Sans CJK JP
font-size = 11
font-thicken = false

# Theme (user file in ~/.config/ghostty/themes/, tracked in yadm)
theme = catppuccin-mocha.conf

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-decoration = false

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = true
copy-on-select = clipboard

# Scrollback (bytes; ~10MB of history)
scrollback-limit = 10000000

# Shell integration (fish is auto-detected)
shell-integration-features = no-cursor,sudo

# Transparency
# Blur comes from Hyprland's decoration.blur block — Ghostty's own
# background-blur is KDE Plasma only and does nothing here.
background-opacity = 0.50
selection-background = 585b70
selection-foreground = cdd6f4
