#!/usr/bin/env bash
DIR="$HOME/Pictures/wallpapers/mocha"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
INTERVAL="${1:-}"

command -v awww >/dev/null 2>&1 || exit 0
[ -d "$DIR" ] || exit 0

OUTPUTS=(DP-1:200 DP-2:120)

pick() {
  local state="$1" last cur
  last="$(cat "$state" 2>/dev/null)"
  for _ in 1 2 3 4 5; do
    cur="$(find "$DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' \) | shuf -n1)"
    [ "$cur" != "$last" ] && break
  done
  printf '%s' "$cur" | tee "$state"
}

set_output() {
  local out="$1" fps="$2" wall filter
  wall="$(pick "$RUN/randwall.last.$out")"
  case "$(basename "$wall")" in
    pixel*|voxel*|retro*) filter=Nearest ;;
    *)                    filter=Lanczos3 ;;
  esac
  awww img "$wall" \
    --outputs "$out" \
    --filter "$filter" \
    --transition-type random \
    --transition-duration 1.5 \
    --transition-fps "$fps"
}

set_wall() {
  local wall filter entry
  wall="$(pick "$RUN/randwall.last")"
  case "$(basename "$wall")" in
    pixel*|voxel*|retro*) filter=Nearest ;;
    *)                    filter=Lanczos3 ;;
  esac
  for entry in "${OUTPUTS[@]}"; do
    awww img "$wall" --outputs "${entry%%:*}" --filter "$filter" \
      --transition-type random --transition-duration 1.5 \
      --transition-fps "${entry##*:}"
  done
}

awww query &>/dev/null || { awww-daemon & sleep 0.5; }

set_wall

if [ -n "$INTERVAL" ]; then
  while sleep "$INTERVAL"; do set_wall; done
fi
