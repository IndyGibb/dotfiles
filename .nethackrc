# ~/.nethackrc — NetHack 5.0.0, local curses build
#
# NOTE: nethackrc only treats '#' as a comment when it is the FIRST character
# on the line. Do NOT put a comment after an OPTIONS= value on the same line —
# it gets parsed as part of the option and errors out.

# ---- Interface ----
OPTIONS=windowtype:curses
# curses: draw window borders when the terminal is big enough
OPTIONS=windowborders:3
OPTIONS=color,time,showexp,showscore
# nicer line-drawn walls on a real local terminal; delete this line if walls look wrong
OPTIONS=symset:DECgraphics
OPTIONS=perm_invent

# ---- Movement / digging ----
# numpad movement; set to 0 for vi-keys (hjkl + yubn)
OPTIONS=number_pad:2
# auto-dig into rock with a pick/mattock (careful: can dig *down* through the floor)
OPTIONS=autodig
# distinct boulder glyph
OPTIONS=boulder:0

# ---- Pickup ----
# pick everything up by hand
OPTIONS=!autopickup
# Alternative: autopickup ONLY ammo (for a ranged/thrown build).
# Delete the !autopickup line above, then uncomment these:
#OPTIONS=autopickup
#OPTIONS=pickup_types:$
#AUTOPICKUP_EXCEPTION="<*arrow*"
#AUTOPICKUP_EXCEPTION="<*bolt*"
#AUTOPICKUP_EXCEPTION="<*dagger*"

# ---- Quality of life ----
# sort inventory and pickup menus
OPTIONS=sortloot:full
# mark your pet so you don't attack it by accident
OPTIONS=hilite_pet
# require explicit confirmation for these dangerous actions
OPTIONS=paranoid_confirmation:Confirm quit attack pray Remove swim trap
# auto-reveal inventory/attributes/vanquished/genocided/conduct/overview at game end
OPTIONS=disclose:+i +a +v +g +c +o
OPTIONS=!tutorial
OPTIONS=fruit:slime mold
OPTIONS=mention_decor,pile_limit:0

# ---- Status highlighting ----
OPTIONS=statushilites:10

# HP by percentage. Critical tier is red&inverse (black is invisible on a dark theme).
OPTIONS=hilite_status: hitpoints/100%/green&normal
OPTIONS=hilite_status: hitpoints/<100%/lightgreen&normal
OPTIONS=hilite_status: hitpoints/<76%/yellow&normal
OPTIONS=hilite_status: hitpoints/<51%/orange&normal
OPTIONS=hilite_status: hitpoints/<26%/red&normal
OPTIONS=hilite_status: hitpoints/<11%/red&inverse

# Hunger warnings
OPTIONS=hilite_status: hunger/Hungry/yellow&normal
OPTIONS=hilite_status: hunger/Weak/orange&normal
OPTIONS=hilite_status: hunger/Fainting/red&inverse

# Encumbrance
OPTIONS=hilite_status: carrying-capacity/Burdened/yellow&normal
OPTIONS=hilite_status: carrying-capacity/Stressed/orange&normal
OPTIONS=hilite_status: carrying-capacity/Strained/red&normal

# Lethal countdown conditions — make them impossible to miss
OPTIONS=hilite_status: condition/stone+slime+strngl+foodpois+termill/red&inverse
